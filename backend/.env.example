# --- Database ---
# Production / docker-compose:
DATABASE_URL=postgresql+psycopg://betala:betala@localhost:5432/betala
# Local dev without Postgres (uncomment instead):
# DATABASE_URL=sqlite:///./betala.db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set true to run tasks in-process (no worker / broker needed):
CELERY_EAGER=false

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=support@betala.link
RESEND_FROM_NAME=Betala Link

# --- App ---
PUBLIC_BASE_URL=https://betala.link
CORS_ORIGINS=http://localhost:5173,https://betala.link
# Long random secret. Required for any /admin/* endpoint.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Dedicated JWT signing secret. If empty, falls back to ADMIN_TOKEN (dev convenience).
# Production MUST set this to its own long random string.
JWT_SECRET=
# Access token lifetime in minutes (default 720 = 12h)
ACCESS_TOKEN_MINUTES=720
# Where uploaded support photos are written (relative to backend/ or absolute):
UPLOADS_DIR=uploads
# Logging
LOG_LEVEL=INFO
# Set true to expose /api/_debug/* endpoints (do NOT enable in production)
DEBUG_ENDPOINTS=false
# Comma-separated host whitelist for TrustedHostMiddleware. Empty = disabled.
# Production example: TRUSTED_HOSTS=betala.link,www.betala.link
TRUSTED_HOSTS=
# Smallest response (bytes) that gets gzipped:
GZIP_MIN_SIZE=500

# --- Rate limiting (slowapi) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PUBLIC_POST=20/minute
RATE_LIMIT_UPLOAD=10/minute
# Optional shared storage. Empty = in-memory (per process).
# Production multi-replica example: redis://redis:6379/3
RATE_LIMIT_STORAGE_URI=

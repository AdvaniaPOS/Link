# --- Database ---
# Production / docker-compose:
DATABASE_URL=postgresql+psycopg://betala:betala@localhost:5432/betala
# Local dev without Postgres (uncomment instead):
# DATABASE_URL=sqlite:///./betala.db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set true to run tasks in-process (no worker / broker needed):
CELERY_EAGER=false

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=support@betala.link
RESEND_FROM_NAME=Betala Link

# --- App ---
PUBLIC_BASE_URL=https://betala.link
CORS_ORIGINS=http://localhost:5173,https://betala.link
# Long random secret. Required for any /admin/* endpoint.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Where uploaded support photos are written (relative to backend/ or absolute):
UPLOADS_DIR=uploads
